.asr{
--ink:#2c2621;
--muted:#6c635a;
--line:#ded4c6;
--paper:#ffffff;
--bg:#faf8f4;
--maroon:#6B1414;
box-sizing:border-box;
width:auto;
margin-left:calc(50% - 50vw);
margin-right:calc(50% - 50vw);
font-family:"Nunito Sans",system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
color:var(--ink);
background:var(--bg);
padding:clamp(48px,6vw,80px) clamp(18px,4vw,32px);
line-height:1.5;
-webkit-font-smoothing:antialiased;
overflow-x:clip;
}
.asr *,.asr *::before,.asr *::after{box-sizing:border-box;}
.asr__inner{max-width:1500px;margin:0 auto;}
.asr__head{text-align:center;max-width:820px;margin:0 auto;}
.asr .asr__title{
font-family:"Poppins",system-ui,sans-serif !important;font-weight:700 !important;
font-size:clamp(32px,5vw,55px) !important;line-height:1.06 !important;letter-spacing:-.01em;margin:0 0 !important;
color:#6B1414 !important;
}
.asr .asr__intro{margin:18px auto 0;font-size:clamp(16px,1.8vw,20px);line-height:1.6;color:var(--muted);max-width:58ch;}
.asr .asr__hint{margin:12px 0 0;font-size:14px;color:var(--muted);opacity:.8;}
.asr__track{
position:relative;
display:flex;
justify-content:space-between;
align-items:flex-start;
margin-top:clamp(70px,8vw,104px);
padding-bottom:170px;
}
.asr__track::before{
content:"";
position:absolute;
top:46px;left:10%;right:10%;
height:2px;
background:var(--line);
z-index:0;
}
.asr__node{
position:relative;
flex:1;
display:flex;
flex-direction:column;
align-items:center;
text-align:center;
cursor:default;
outline:none;
}
.asr__dot{
width:92px;height:92px;border-radius:50%;
background:var(--c);
border:6px solid var(--bg);
display:flex;align-items:center;justify-content:center;
color:#fff;position:relative;z-index:1;
transition:transform .22s ease,box-shadow .22s ease;
}
.asr__dot svg{width:38px;height:38px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
.asr .asr__name{
font-family:"Poppins",system-ui,sans-serif !important;font-weight:600 !important;
font-size:21px !important;line-height:1.2;color:var(--c) !important;
margin-top:16px;
}
.asr__panel{
position:absolute;
top:150px;left:50%;
width:min(240px,74vw);
transform:translateX(-50%) translateY(8px);
background:var(--paper);
border:1px solid #ece5da;
border-top:3px solid var(--c);
border-radius:12px;
padding:16px 18px;
box-shadow:0 16px 34px rgba(44,38,33,.13);
font-size:15px;line-height:1.55;color:var(--muted);
opacity:0;visibility:hidden;pointer-events:none;
transition:opacity .2s ease,transform .2s ease;
z-index:5;
}
.asr__node:hover .asr__dot,
.asr__node:focus-visible .asr__dot{
transform:translateY(-3px);
box-shadow:0 0 0 8px color-mix(in srgb,var(--c) 16%,transparent);
}
.asr__node:hover .asr__panel,
.asr__node:focus-visible .asr__panel,
.asr__node:focus-within .asr__panel{
opacity:1;visibility:visible;transform:translateX(-50%) translateY(0);
}
@media (max-width:720px){
.asr__hint{display:none;}
.asr__track{flex-direction:column;align-items:stretch;gap:24px;padding-bottom:0;margin-top:44px;}
.asr__track::before{top:0;bottom:0;left:40px;right:auto;width:2px;height:auto;}
.asr__node{flex-direction:row;align-items:flex-start;text-align:left;gap:20px;}
.asr__dot{width:72px;height:72px;flex:0 0 72px;}
.asr__dot svg{width:30px;height:30px;}
.asr .asr__name{margin-top:0;font-size:20px !important;}
.asr__body{display:flex;flex-direction:column;gap:6px;padding-top:8px;}
.asr__panel{
position:static;width:auto;transform:none;opacity:1;visibility:visible;pointer-events:auto;
box-shadow:none;border:none;border-left:3px solid var(--c);border-radius:0;padding:2px 0 0 14px;font-size:15.5px;
}
}
@media (prefers-reduced-motion:reduce){
.asr__dot,.asr__panel{transition:none;}
.asr__node:hover .asr__dot,.asr__node:focus-visible .asr__dot{transform:none;}
}
</style>

